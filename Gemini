<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hotel Management System</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }

        .container {
            width: 90%;
            max-width: 1200px;
            margin: 20px auto;
            background-color: #fff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        }

        header {
            background-color: #333;
            color: #fff;
            text-align: center;
            padding: 1em 0;
            border-radius: 8px 8px 0 0;
        }

        nav {
            background-color: #eee;
            padding: 10px;
            border-radius: 0 0 8px 8px;
            text-align: center;
            margin-bottom: 20px;
        }

        nav a {
            text-decoration: none;
            color: #333;
            padding: 8px 15px;
            margin: 0 10px;
            border-radius: 5px;
            transition: background-color 0.3s ease;
        }

        nav a:hover {
            background-color: #ddd;
        }

        .content {
            padding: 20px 0;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: bold;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: calc(100% - 22px);
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            box-sizing: border-box;
        }

        button {
            background-color: #007bff;
            color: #fff;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        button:hover {
            background-color: #0056b3;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }

        th {
            background-color: #f2f2f2;
        }
        .user-view, .manager-view{
            display: none;
        }
        .active{
            display: block;
        }
    </style>
</head>
<body>

    <div class="container">
        <header>
            <h1>Hotel Management System</h1>
        </header>
        <nav>
            <a href="#" onclick="showView('user')">User View</a>
            <a href="#" onclick="showView('manager')">Manager View</a>
        </nav>

        <div class="content user-view active" id="user-view">
            <h2>User Dashboard</h2>
            <div class="form-group">
                <label for="checkin">Check-in Date:</label>
                <input type="date" id="checkin">
            </div>
            <div class="form-group">
                <label for="checkout">Check-out Date:</label>
                <input type="date" id="checkout">
            </div>
            <div class="form-group">
                <label for="roomType">Room Type:</label>
                <select id="roomType">
                    <option value="single">Single</option>
                    <option value="double">Double</option>
                    <option value="suite">Suite</option>
                </select>
            </div>
            <button>Book Room</button>
            <h3>Your Bookings:</h3>
            <table>
                <thead>
                    <tr>
                        <th>Check-in</th>
                        <th>Check-out</th>
                        <th>Room Type</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>2023-11-20</td>
                        <td>2023-11-25</td>
                        <td>Double</td>
                        <td>Confirmed</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="content manager-view" id="manager-view">
            <h2>Manager Dashboard</h2>
            <h3>Room Management</h3>
            <div class="form-group">
                <label for="roomNumber">Room Number:</label>
                <input type="text" id="roomNumber">
            </div>
            <div class="form-group">
                <label for="roomTypeManager">Room Type:</label>
                <select id="roomTypeManager">
                    <option value="single">Single</option>
                    <option value="double">Double</option>
                    <option value="suite">Suite</option>
                </select>
            </div>
            <div class="form-group">
                <label for="roomStatus">Room Status:</label>
                <select id="roomStatus">
                    <option value="available">Available</option>
                    <option value="occupied">Occupied</option>
                    <option value="maintenance">Maintenance</option>
                </select>
            </div>
            <button>Update Room</button>

            <h3>Booking Management</h3>
            <table>
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Check-in</th>
                        <th>Check-out</th>
                        <th>Room</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>John Doe</td>
                        <td>2023-11-20</td>
                        <td>2023-11-25</td>
                        <td>101</td>
                        <td>Confirmed</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <script>
        function showView(view) {
            document.querySelectorAll('.content').forEach(el => el.classList.remove('active'));
            document.getElementById(view + '-view').classList.add('active');
        }
    </script>
</body>
</html>